+            const char *rp = find_value(obeg, olen, "reason");
+            if (rp) copy_string(rp, oe, c->gap_cert_reason, sizeof c->gap_cert_reason);
+            const char *bp = find_value(obeg, olen, "bead");
+            if (bp) copy_string(bp, oe, c->gap_cert_bead, sizeof c->gap_cert_bead);
