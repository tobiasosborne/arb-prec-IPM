+    int    gap_certificate;              /* 1 if a known_gaps entry has kind "certificate" */
+    char   gap_cert_reason[256];         /* that entry's reason ("" if none) */
+    char   gap_cert_bead[64];            /* that entry's bead ("" if none) */
 } golden_case;
