             if (rp) copy_string(rp, oe, c->gap_reason, sizeof c->gap_reason);
@@ -119,6 +127,32 @@ static void parse_gaps(const char *buf, size_t len, golden_case *c) {
     }
 }
 
+/* Parse a flat array of quoted strings at key into dst[0..maxn-1] (bounded).
+ * Returns the count (>= 0; 0 if the key is absent), or -1 if malformed (not an
+ * array, an unquoted element, an element too long, or more than maxn). */
+static int parse_string_array(const char *buf, size_t len, const char *key,
+                              char dst[][80], int maxn) {
+    const char *p = find_value(buf, len, key);
+    const char *end = buf + len;
+    int k = 0;
+    if (!p) return 0;
+    if (p >= end || *p != '[') return -1;
+    p++;
+    for (;;) {
+        while (p < end && (isspace((unsigned char)*p) || *p == ',')) p++;
+        if (p >= end) return -1;
+        if (*p == ']') return k;
+        if (*p != '"' || k >= maxn) return -1;
+        const char *q = p + 1;
+        while (q < end && *q != '"') q++;
+        if (q >= end || (size_t)(q - p - 1) >= 80) return -1;
+        memcpy(dst[k], p + 1, (size_t)(q - p - 1));
+        dst[k][q - p - 1] = '\0';
+        k++;
+        p = q + 1;
+    }
+}
+
 /* Parse one provenance file at path into *c (dats_path is set by caller). Returns
  * 1 on success, 0 on hard error (already reported to stderr). */
 static int parse_provenance(const char *path, golden_case *c) {
@@ -165,7 +199,52 @@ static int parse_provenance(const char *path, golden_case *c) {
     opt_bool(buf, len, "maximize", &c->maximize); /* absent -> default 1 (unchanged) */
     opt_string(buf, len, "expected_status", c->expected_status, sizeof c->expected_status);
     parse_gaps(buf, len, c);
+
+    /* Certificate-gate keys (bead arb-prec-IPM-ehz).  An a-priori trace bound is
+     * what makes a "rigorous" bracket true (CLAUDE.md invariant 5), so an
+     * unjustified or malformed one is a malformed golden: fail loud (rule 5). */
+    c->expected_min_certified_digits = -1;
+    if (opt_number(buf, len, "expected_min_certified_digits", num, sizeof num))
+        c->expected_min_certified_digits = (int)strtol(num, NULL, 10);
+    opt_string(buf, len, "trace_bound_justification", c->trace_bound_justification,
+               sizeof c->trace_bound_justification);
+    opt_string(buf, len, "trace_bound_absent_reason", c->trace_bound_absent_reason,
+               sizeof c->trace_bound_absent_reason);
+    c->n_trace_bounds = parse_string_array(buf, len, "trace_bounds", c->trace_bounds,
+                                           GOLDEN_MAX_BLOCKS);
     free(buf);
+    if (c->n_trace_bounds < 0) {
+        fprintf(stderr, "FATAL: %s: malformed \"trace_bounds\" (want an array of "
+                "<= %d decimal strings)\n", path, GOLDEN_MAX_BLOCKS);
+        return 0;
+    }
+    for (int b = 0; b < c->n_trace_bounds; b++) {
+        /* strict finite decimal literal (no inf/nan/ball/doubled sign), and >= 0:
+         * tr(X_b) >= 0 on every PSD / diagonal block (bead 2ny). */
+        if (arbsdp_decimal_is_valid(c->trace_bounds[b]) != 0 || c->trace_bounds[b][0] == '-') {
+            fprintf(stderr, "FATAL: %s: trace_bounds[%d]=\"%s\" is not a finite "
+                    "decimal literal >= 0\n", path, b, c->trace_bounds[b]);
+            return 0;
+        }
+    }
+    if (c->n_trace_bounds > 0) {
+        if (c->trace_bound_justification[0] == '\0') {
+            fprintf(stderr, "FATAL: %s: \"trace_bounds\" without a "
+                    "\"trace_bound_justification\" (an unjustified xbar is how a "
+                    "rigorous bracket becomes false)\n", path);
+            return 0;
+        }
+        if (c->expected_min_certified_digits < 0) {
+            fprintf(stderr, "FATAL: %s: \"trace_bounds\" without "
+                    "\"expected_min_certified_digits\"\n", path);
+            return 0;
+        }
+    } else if (strcmp(c->expected_status, "optimal") == 0 &&
+               c->trace_bound_absent_reason[0] == '\0') {
+        fprintf(stderr, "FATAL: %s: optimal golden with neither \"trace_bounds\" "
+                "nor \"trace_bound_absent_reason\"\n", path);
+        return 0;
+    }
     return 1;
 }
 
