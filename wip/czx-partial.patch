+        if (!arf_is_finite(d + i))
+            status = ARBSDP_EIGH_NOT_CONVERGED;
+        arb_set_arf(eigvals + i, d + i);
+    }
+
+cleanup:
+    _arf_vec_clear(a, n * n);
+    _arf_vec_clear(d, n);
+    _arf_vec_clear(e, n);
+    _arf_vec_clear(v, n);
+    _arf_vec_clear(w, n);
+    arf_clear(t); arf_clear(u); arf_clear(alpha); arf_clear(beta); arf_clear(K);
+    arf_clear(g); arf_clear(r); arf_clear(s); arf_clear(c); arf_clear(p);
+    arf_clear(f); arf_clear(b); arf_clear(dd); arf_clear(eps);
+    return status;
+}
