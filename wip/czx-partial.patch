+
+/*
+ * GROUND TRUTH (CLAUDE.md rule 3):
+ *   - Householder reduction to tridiagonal form: Golub & Van Loan, Matrix
+ *     Computations (4th ed.), Alg. 8.3.1 (symmetric Householder tridiagonal-
+ *     ization; the rank-2 update A22 -= v w^T + w v^T with p = beta A22 v,
+ *     w = p - (beta v^T p / 2) v, beta = 2 / v^T v).
+ *   - Implicit QL with a Wilkinson-type shift, eigenvalues only: EISPACK tql1
+ *     (Bowdler, Martin, Reinsch, Wilkinson, Numer. Math. 11 (1968) 293-306);
+ *     loop structure as Numerical Recipes 2nd ed. sec. 11.3 tqli, with the
+ *     deflation test |e_m| <= 2^-prec (|d_m| + |d_{m+1}|).
+ *   - Both are backward stable: computed eigenvalues are exact for A + E,
+ *     ||E|| = O(n ||A|| 2^-prec)  (Golub-Van Loan sec. 8.3.6), the same
+ *     absolute accuracy class as cyclic Jacobi on an indefinite input.
+ * AUDITION (docs/MATH_SPEC.md sec. 3.7.1): 2.2-33x faster than arbsdp_eigh
+ * at n in {4..32}, prec in {128..2048}, 3-6 bits better absolute accuracy.
+ *
+ * POINT MODE (CLAUDE.md rule 1; bead h62): the input is read as MIDPOINTS
+ * and all arithmetic is arf with round-to-nearest at `prec` -- no radii are
+ * ever formed, so none can truncate sqrt/div results.
+ */
+#define EIGVALSH_MAX_QL_ITERS 200   /* per eigenvalue; typical is 2-6 (cubic) */
+
+int
+arbsdp_eigvalsh(arb_ptr eigvals, const arb_mat_t A, slong prec)
+{
+    const arf_rnd_t rnd = ARF_RND_NEAR;
+    slong n = arb_mat_nrows(A);
+    arf_ptr a, d, e, v, w;
+    arf_t t, u, alpha, beta, K, g, r, s, c, p, f, b, dd, eps;
+    int status = 0;
+
+    assert(arb_mat_nrows(A) == arb_mat_ncols(A));     /* square */
+    eigvalsh_count++;
+    if (n == 0)
+        return 0;
+
+    a = _arf_vec_init(n * n);
+    d = _arf_vec_init(n);
+    e = _arf_vec_init(n);
+    v = _arf_vec_init(n);
+    w = _arf_vec_init(n);
+    arf_init(t); arf_init(u); arf_init(alpha); arf_init(beta); arf_init(K);
+    arf_init(g); arf_init(r); arf_init(s); arf_init(c); arf_init(p);
+    arf_init(f); arf_init(b); arf_init(dd); arf_init(eps);
+
+#define A_(i, j) (a + (i) * n + (j))
+    /* a = mid((A + A^T)/2): the symmetric part, as for arbsdp_eigh. */
+    for (slong i = 0; i < n; i++)
+        for (slong j = 0; j < n; j++) {
+            arf_add(A_(i, j), arb_midref(arb_mat_entry(A, i, j)),
+                    arb_midref(arb_mat_entry(A, j, i)), prec, rnd);
+            arf_mul_2exp_si(A_(i, j), A_(i, j), -1);
+            if (!arf_is_finite(A_(i, j)))
+                status = ARBSDP_EIGH_NOT_CONVERGED;   /* fail loud on NaN/Inf */
+        }
+    if (status != 0)
+        goto cleanup;
+
+    /* --- Householder tridiagonalization (GVL Alg. 8.3.1) ----------------- */
+    for (slong k = 0; k + 2 < n; k++) {
+        slong m = n - k - 1;                 /* x = A[k+1 .. n-1, k] */
+        arf_zero(u);
+        for (slong i = 0; i < m; i++)
+            arf_addmul(u, A_(k + 1 + i, k), A_(k + 1 + i, k), prec, rnd);
+        if (arf_is_zero(u))
+            continue;                        /* column already reduced */
+        arf_sqrt(alpha, u, prec, rnd);       /* ||x|| */
+        if (arf_sgn(A_(k + 1, k)) > 0)
+            arf_neg(alpha, alpha);           /* alpha = -sign(x_0) ||x|| */
+        for (slong i = 0; i < m; i++)
+            arf_set(v + i, A_(k + 1 + i, k));
+        arf_sub(v + 0, v + 0, alpha, prec, rnd);   /* v = x - alpha e_1 */
+        arf_zero(t);
+        for (slong i = 0; i < m; i++)
+            arf_addmul(t, v + i, v + i, prec, rnd);
+        if (arf_is_zero(t))
+            continue;
+        arf_ui_div(beta, 2, t, prec, rnd);   /* beta = 2 / v^T v */
+        for (slong i = 0; i < m; i++) {      /* w = beta A22 v */
+            arf_zero(u);
+            for (slong j = 0; j < m; j++)
+                arf_addmul(u, A_(k + 1 + i, k + 1 + j), v + j, prec, rnd);
+            arf_mul(w + i, u, beta, prec, rnd);
+        }
+        arf_zero(K);                         /* K = beta v^T w / 2 */
+        for (slong i = 0; i < m; i++)
+            arf_addmul(K, v + i, w + i, prec, rnd);
+        arf_mul(K, K, beta, prec, rnd);
+        arf_mul_2exp_si(K, K, -1);
+        for (slong i = 0; i < m; i++)        /* w -= K v */
+            arf_submul(w + i, K, v + i, prec, rnd);
+        for (slong i = 0; i < m; i++)        /* A22 -= v w^T + w v^T */
+            for (slong j = 0; j <= i; j++) {
+                arf_submul(A_(k + 1 + i, k + 1 + j), v + i, w + j, prec, rnd);
+                arf_submul(A_(k + 1 + i, k + 1 + j), w + i, v + j, prec, rnd);
+                arf_set(A_(k + 1 + j, k + 1 + i), A_(k + 1 + i, k + 1 + j));
+            }
+        arf_set(A_(k + 1, k), alpha);        /* the new subdiagonal entry */
+    }
+    for (slong i = 0; i < n; i++)
+        arf_set(d + i, A_(i, i));
+    for (slong i = 0; i + 1 < n; i++)
+        arf_set(e + i, A_(i + 1, i));
+    arf_zero(e + n - 1);
+#undef A_
+
+    /* --- implicit QL, eigenvalues only (tql1 / NR tqli) ------------------ */
+    arf_one(eps);
+    arf_mul_2exp_si(eps, eps, -prec);
+    for (slong l = 0; l < n; l++) {
+        int iter = 0;
+        slong mm;
+        do {
+            for (mm = l; mm < n - 1; mm++) { /* deflation: small e_mm */
+                arf_abs(dd, d + mm);
+                arf_abs(t, d + mm + 1);
+                arf_add(dd, dd, t, prec, rnd);
+                arf_mul(dd, dd, eps, prec, rnd);
+                if (arf_cmpabs(e + mm, dd) <= 0)
+                    break;
+            }
+            if (mm != l) {
+                int zr = 0;
+                if (iter++ == EIGVALSH_MAX_QL_ITERS) {
+                    status = ARBSDP_EIGH_NOT_CONVERGED;
+                    goto cleanup;
+                }
+                /* shift: g = d_mm - d_l + e_l / (g + sign(g) sqrt(g^2+1)),
+                 * g = (d_{l+1} - d_l) / (2 e_l) */
+                arf_sub(g, d + l + 1, d + l, prec, rnd);
+                arf_mul_2exp_si(t, e + l, 1);
+                arf_div(g, g, t, prec, rnd);
+                arf_mul(r, g, g, prec, rnd);
+                arf_add_ui(r, r, 1, prec, rnd);
+                arf_sqrt(r, r, prec, rnd);
+                if (arf_sgn(g) < 0)
+                    arf_sub(t, g, r, prec, rnd);
+                else
+                    arf_add(t, g, r, prec, rnd);
+                arf_div(t, e + l, t, prec, rnd);
+                arf_sub(g, d + mm, d + l, prec, rnd);
+                arf_add(g, g, t, prec, rnd);
+                arf_one(s);
+                arf_one(c);
+                arf_zero(p);
+                for (slong i = mm - 1; i >= l; i--) {   /* plane rotations */
+                    arf_mul(f, s, e + i, prec, rnd);
+                    arf_mul(b, c, e + i, prec, rnd);
+                    arf_mul(r, f, f, prec, rnd);
+                    arf_addmul(r, g, g, prec, rnd);
+                    arf_sqrt(r, r, prec, rnd);          /* r = hypot(f, g) */
+                    arf_set(e + i + 1, r);
+                    if (arf_is_zero(r)) {               /* underflow recovery */
+                        arf_sub(d + i + 1, d + i + 1, p, prec, rnd);
+                        arf_zero(e + mm);
+                        zr = 1;
+                        break;
+                    }
+                    arf_div(s, f, r, prec, rnd);
+                    arf_div(c, g, r, prec, rnd);
+                    arf_sub(g, d + i + 1, p, prec, rnd);
+                    arf_sub(r, d + i, g, prec, rnd);
+                    arf_mul(r, r, s, prec, rnd);
+                    arf_mul(t, c, b, prec, rnd);
+                    arf_mul_2exp_si(t, t, 1);
+                    arf_add(r, r, t, prec, rnd);        /* r = (d_i - g)s + 2cb */
+                    arf_mul(p, s, r, prec, rnd);
+                    arf_add(d + i + 1, g, p, prec, rnd);
+                    arf_mul(g, c, r, prec, rnd);
+                    arf_sub(g, g, b, prec, rnd);
+                }
+                if (zr)
+                    continue;
+                arf_sub(d + l, d + l, p, prec, rnd);
+                arf_set(e + l, g);
+                arf_zero(e + mm);
+            }
+        } while (mm != l);
+    }
+
+    /* insertion sort ascending; exact (radius-0) arb outputs */
+    for (slong i = 1; i < n; i++)
+        for (slong j = i; j > 0 && arf_cmp(d + j - 1, d + j) > 0; j--)
+            arf_swap(d + j - 1, d + j);
