+/*
+ * arbsdp_psd_strict_pd uses the SAME b30 threshold as psd_invsqrt:
+ * lambda_min > lambda_max * 2^(-prec/2).  diag(1, 2^-(prec/2 - 8)) passes,
+ * diag(1, 2^-(prec/2 + 8)), diag(1, 0) and diag(1, -1) fail, and the decisions
+ * agree with psd_invsqrt's gate on the same inputs.  MUTATION: comparing
+ * against 2^(-prec) instead of 2^(-prec/2) turns the 2^-(prec/2+8) case red.
+ */
+static void
+test_strict_pd_threshold(void)
+{
+    const slong n = 2;
+    const slong exps[] = {PREC / 2 - 8, PREC / 2 + 8};
+    arb_mat_t A, R;
+    arb_mat_init(A, n, n);
+    arb_mat_init(R, n, n);
+    for (int k = 0; k < 2; k++) {
+        int want = (k == 0);
+        arb_mat_zero(A);
+        arb_one(arb_mat_entry(A, 0, 0));
+        arb_one(arb_mat_entry(A, 1, 1));
+        arb_mul_2exp_si(arb_mat_entry(A, 1, 1), arb_mat_entry(A, 1, 1), -exps[k]);
+        CHECK(arbsdp_psd_strict_pd(A, PREC) == want,
+              "strict_pd: b30 threshold lambda_min > lambda_max 2^(-prec/2)");
+        CHECK((arbsdp_psd_invsqrt(R, A, PREC) == 0) == want,
+              "strict_pd must agree with the psd_invsqrt gate");
+    }
+    arb_mat_zero(A);
+    arb_one(arb_mat_entry(A, 0, 0));
+    CHECK(arbsdp_psd_strict_pd(A, PREC) == 0, "strict_pd: diag(1,0) is not PD");
+    arb_set_si(arb_mat_entry(A, 1, 1), -1);
+    CHECK(arbsdp_psd_strict_pd(A, PREC) == 0, "strict_pd: diag(1,-1) is not PD");
+    arb_mat_clear(A);
+    arb_mat_clear(R);
+}
