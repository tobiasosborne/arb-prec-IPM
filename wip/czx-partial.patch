+/*
+ * arbsdp_psd_strict_pd -- the b30 strict-PD gate (see psd_pow_half) evaluated
+ * on eigenvalues only: 1 iff the kernel converged and
+ *     lambda_min > max(0, lambda_max) * 2^(-prec/2);
+ * 0 otherwise.  Same rule and threshold as the psd_sqrt / psd_invsqrt gate.
+ * The eigenvalues come from arbsdp_eigvalsh (absolute accuracy
+ * O(n ||A|| 2^-prec)), so the decision can differ from the Jacobi-based gate
+ * only for lambda_min inside a relative ~2^-(prec/2) band around the
+ * threshold.  (The gate's arb_contains_zero clause is subsumed: eigvalsh
+ * returns exact points, so a zero-straddling ball cannot occur.)
+ */
+int
+arbsdp_psd_strict_pd(const arb_mat_t A, slong prec)
+{
+    slong n = arb_mat_nrows(A);
+    arb_ptr lam;
+    arf_t floor_lam;
+    int pd = 1;
+
+    assert(arb_mat_nrows(A) == arb_mat_ncols(A));     /* square */
+    if (n == 0)
+        return 1;
+    lam = _arb_vec_init(n);
+    arf_init(floor_lam);
+
+    if (arbsdp_eigvalsh(lam, A, prec) != 0) {
+        pd = 0;
+    } else {
+        if (arf_sgn(arb_midref(lam + n - 1)) <= 0)
+            arf_zero(floor_lam);
+        else
+            arf_mul_2exp_si(floor_lam, arb_midref(lam + n - 1), -(prec / 2));
+        if (arf_cmp(arb_midref(lam + 0), floor_lam) <= 0)
+            pd = 0;
+    }
+
+    arf_clear(floor_lam);
+    _arb_vec_clear(lam, n);
+    return pd;
+}
