+/*
+ * eigvalsh agrees with eigh (both ascending) to ~prec bits on random symmetric
+ * matrices, n in {1,2,5,12,24}, prec in {128, 512, 2048}.  Reference: eigh at
+ * 4*prec on the same exact input.  Tolerance n * 2^-(prec-16) (absolute,
+ * backward-stable class; entries are <= 1 so ||A|| <= n).  MUTATION: dropping
+ * the 2cb term of the QL rotation (r = (d_i - g)s) turns this red.
+ */
+static void
+test_eigvalsh_matches_eigh(void)
+{
+    const slong ns[] = {1, 2, 5, 12, 24};
+    const slong ps[] = {128, 512, 2048};
+    flint_rand_t st;
+    flint_randinit(st);
+    for (int a = 0; a < 5; a++)
+        for (int b = 0; b < 3; b++) {
+            slong n = ns[a], pr = ps[b];
+            arb_mat_t A, Q;
+            arb_ptr ref, lam;
+            arf_t dif, tol;
+            int ok = 1;
+            arb_mat_init(A, n, n);
+            arb_mat_init(Q, n, n);
+            ref = _arb_vec_init(n);
+            lam = _arb_vec_init(n);
+            arf_init(dif);
+            arf_init(tol);
+            fill_sym_random(A, st);
+            ok &= (arbsdp_eigh(ref, Q, A, 4 * pr) == 0);
+            ok &= (arbsdp_eigvalsh(lam, A, pr) == 0);
+            arf_one(tol);
+            arf_mul_2exp_si(tol, tol, -(pr - 16));
+            arf_mul_si(tol, tol, n, 64, ARF_RND_UP);
+            for (slong i = 0; i < n; i++) {
+                arf_sub(dif, arb_midref(lam + i), arb_midref(ref + i),
+                        4 * pr, ARF_RND_NEAR);
+                if (arf_cmpabs(dif, tol) > 0)
+                    ok = 0;
+                if (!mag_is_zero(arb_radref(lam + i)))
+                    ok = 0;                            /* exact point outputs */
+            }
+            CHECK(ok, "eigvalsh: eigenvalues must match eigh to ~prec bits");
+            arf_clear(dif);
+            arf_clear(tol);
+            _arb_vec_clear(ref, n);
+            _arb_vec_clear(lam, n);
+            arb_mat_clear(A);
+            arb_mat_clear(Q);
+        }
+    flint_randclear(st);
+}
