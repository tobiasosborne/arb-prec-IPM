+/* --------------------------------------------------------------------------
+ * (b) min_eig_path_4 (target 30) and min_eig_path_4_td120 (target 120): min
+ * <T_4(2,1),X>, tr X = 1, opt = lambda_min = (3 - sqrt5)/2.  xbar = 1 (A_1 = I,
+ * b_1 = 1 pins tr X = 1).  RIGOR against the closed form at CMP_PREC bits AND the
+ * provenance enclosure; TIGHTNESS on BOTH sides (opt - lb and ub - opt) at
+ * gate_digits.  Before fjw: INCONCLUSIVE [-inf, +inf] (agc refusal).
+ * ----------------------------------------------------------------------- */
+static void
+test_minimize_goldens(const golden_case *cases, int n)
+{
+    /* gate_digits: MEASURED (fjw, prec_c = final_prec + 128) opt-lb / ub-opt =
+     * 189.7 / 166.6 digits (td30, prec_c=640) and 323.3 / 323.3 (td120,
+     * prec_c=2176); the gates sit well below with margin for Layer-0 drift but far
+     * above anything a wrong-side or wrong-sign bound can reach (O(1) gaps). */
+    static const struct { const char *name; int gate_digits; } mg[] = {
+        { "min_eig_path_4",       60 },
+        { "min_eig_path_4_td120", 200 },
+    };
+    int nm = (int) (sizeof mg / sizeof mg[0]);
+
+    printf("\nMINIMIZE GOLDENS (fjw): opt=(3-sqrt5)/2 MUST be in [lb,ub], both sides tight:\n");
+    for (int k = 0; k < nm; k++) {
+        const golden_case *c = find_case(cases, n, mg[k].name);
+        CHECK(c != NULL, "minimize_goldens: golden discovered");
+        if (c == NULL)
+            continue;
+        CHECK(c->maximize == 0, "minimize_goldens: provenance says minimize");
+
+        arbsdp_problem p;
+        arbsdp_adaptive_result r;
+        slong prec_c = solve_case_sense(&p, &r, c, c->target_digits);
+
+        arbsdp_apriori ab;
+        arbsdp_apriori_init(&ab, p.nblocks);
+        {
+            arb_t one; arb_init(one); arb_one(one);
+            arbsdp_apriori_set_xbar(&ab, 0, one);
+            arb_clear(one);
+        }
+
+        arb_t lb, ub, opt_cf, opt_enc, glo, ghi, tol;
+        arb_init(lb); arb_init(ub); arb_init(opt_cf); arb_init(opt_enc);
+        arb_init(glo); arb_init(ghi); arb_init(tol);
+
+        /* closed form (3 - sqrt5)/2 at CMP_PREC (radius ~2^-4096). */
+        arb_set_ui(opt_cf, 5);
+        arb_sqrt(opt_cf, opt_cf, CMP_PREC);
+        arb_neg(opt_cf, opt_cf);
+        arb_add_ui(opt_cf, opt_cf, 3, CMP_PREC);
+        arb_mul_2exp_si(opt_cf, opt_cf, -1);
+        parse_opt_enclosure(opt_enc, c, CMP_PREC);
+        CHECK(arb_overlaps(opt_cf, opt_enc),
+              "minimize_goldens: closed form agrees with the provenance value");
+
+        arbsdp_certify_status st =
+            arbsdp_certify_bracket(lb, ub, &p, &r.res.it, &ab, prec_c);
+        CHECK(st == ARBSDP_CERTIFY_OPTIMAL_BRACKET,
+              "minimize_goldens: status OPTIMAL_BRACKET");
+
+        /* RIGOR (rule 2): the TRUE optimum inside [lb, ub]. */
+        CHECK(arb_le(lb, opt_cf), "minimize_goldens: lb <= (3-sqrt5)/2 (P0 if not)");
+        CHECK(arb_le(opt_cf, ub), "minimize_goldens: (3-sqrt5)/2 <= ub (P0 if not)");
+        CHECK(arb_le(lb, opt_enc) || arb_overlaps(lb, opt_enc),
+              "minimize_goldens: lb <= ubound(provenance enclosure)");
+
+        /* TIGHTNESS on BOTH sides. */
+        arb_sub(glo, opt_cf, lb, CMP_PREC);
+        arb_sub(ghi, ub, opt_cf, CMP_PREC);
+        {
+            arb_t ten;
+            arb_init(ten);
+            arb_set_ui(ten, 10);
+            arb_pow_ui(tol, ten, (ulong) mg[k].gate_digits, CMP_PREC);
+            arb_inv(tol, tol, CMP_PREC);
+            arb_clear(ten);
+        }
+        CHECK(arb_lt(glo, tol), "minimize_goldens: opt - lb < 10^-gate (dual side tight)");
+        CHECK(arb_lt(ghi, tol), "minimize_goldens: ub - opt < 10^-gate (primal side tight)");
+
+        {
+            char *slb = arb_get_str(lb, 25, ARB_STR_NO_RADIUS);
+            char *sub = arb_get_str(ub, 25, ARB_STR_NO_RADIUS);
+            printf("  %-22s td=%d prec_c=%ld lb=%s ub=%s digits(opt-lb)=%.1f "
+                   "digits(ub-opt)=%.1f gate=%d\n",
+                   mg[k].name, c->target_digits, (long) prec_c, slb, sub,
+                   gap_digits(glo), gap_digits(ghi), mg[k].gate_digits);
+            flint_free(slb);
+            flint_free(sub);
+        }
+
+        arb_clear(lb); arb_clear(ub); arb_clear(opt_cf); arb_clear(opt_enc);
+        arb_clear(glo); arb_clear(ghi); arb_clear(tol);
+        arbsdp_apriori_clear(&ab);
+        arbsdp_adaptive_result_clear(&r);
+        arbsdp_problem_clear(&p);
+    }
+}
