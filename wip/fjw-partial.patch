+/* negate_objective -- C_file -> -C_file on every stored entry string of matno 0,
+ * and flip the sense: the result is the SAME optimization problem written the
+ * other way round (max <C,X> == -min <-C,X>).  Exact on the decimal strings (a
+ * leading '-' is dropped / added), so the materialized balls are exact negations. */
+static void
+negate_objective(arbsdp_problem *p)
+{
+    for (int b = 0; b < p->nblocks; b++) {
+        arbsdp_matblock *mb = &p->mats[0 * p->nblocks + b];
+        for (int e = 0; e < mb->count; e++) {
+            char *v = mb->entries[e].value;
+            size_t len = strlen(v);
+            char *w = malloc(len + 2);
+            CHECK(w != NULL, "negate_objective: malloc");
+            if (w == NULL)
+                return;
+            if (v[0] == '-')
+                memcpy(w, v + 1, len);            /* "-x" -> "x" (incl. NUL)  */
+            else if (v[0] == '+') {
+                w[0] = '-';
+                memcpy(w + 1, v + 1, len);        /* "+x" -> "-x"             */
+            } else {
+                w[0] = '-';
+                memcpy(w + 1, v, len + 1);        /* "x"  -> "-x"             */
+            }
+            free(v);
+            mb->entries[e].value = w;
+        }
+    }
+    p->maximize = !p->maximize;
+}
+
+/* one_sided_digits -- -log10(d) for a gap d >= 0 (diagnostic; 999 if d == 0). */
+static double
+gap_digits(const arb_t d)
+{
+    double v = arf_get_d(arb_midref(d), ARF_RND_UP);
+    if (v <= 0.0)
+        return 999.0;
+    return -log10(v);
+}
