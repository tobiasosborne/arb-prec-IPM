+/* ==========================================================================
+ * MINIMIZE CERTIFICATION (bead arb-prec-IPM-fjw; MATH_SPEC §5.8).
+ *
+ * Layer 1 certifies min <C,X> through the MAX-FRAME reduction
+ *     min <C_file,X> = -max <-C_file,X>,
+ * bracketing the max-frame problem and mapping [lb', ub'] -> [-ub', -lb'].  For a
+ * minimize problem the FEASIBLE-POINT (Rayleigh) bound therefore lands on the
+ * UPPER side and the dual-residual bound on the LOWER side -- the mirror of max.
+ * ======================================================================== */
+
+/* solve_case_sense -- like solve_to_iterate but honouring the provenance sense
+ * (read_sdpa hardcodes maximize = 1; io.c) and target digits.  Returns prec_c. */
+static slong
+solve_case_sense(arbsdp_problem *p, arbsdp_adaptive_result *r,
+                 const golden_case *c, int target_digits)
+{
+    arbsdp_problem_init(p);
+    CHECK(arbsdp_read_sdpa(p, c->dats_path) == 0, "solve_case_sense: read_sdpa");
+    p->maximize = c->maximize;
+
+    arbsdp_precision_params pp;
+    arbsdp_precision_default_params(&pp);
+    pp.target_digits = target_digits;
+    if (c->prec_cap > pp.prec_max)
+        pp.prec_max = c->prec_cap;
+    arbsdp_solve_adaptive(r, p, &pp);
+    return r->final_prec + 128;
+}
