+/* --------------------------------------------------------------------------
+ * (c) NEGATION CROSS-CHECK of the reduction: for every max bracket golden of
+ * the rigor gate, the minimize problem with C negated is the same problem
+ * written the other way round, so its certified bracket must be EXACTLY the
+ * negated max bracket [-ub, -lb].
+ *   (c1) SAME iterate: the Layer-0 iterate of the max problem is a valid iterate
+ *        of the negated min problem (both solve min <C_int,X> with the same
+ *        C_int = -C_file_max = C_file_min; iterate.c), so certifying the min
+ *        problem from it must give the bit-exact negation.
+ *   (c2) INDEPENDENT solve of the min problem (end-to-end through Layer 0): the
+ *        bracket must contain -opt and agree with the negation within 2^-(prec_c-64).
+ * ----------------------------------------------------------------------- */
+static void
+test_min_negation_crosscheck(const golden_case *cases, int n)
+{
+    static const struct { const char *name; const char *xbar; } nc[] = {
+        { "max_eigenvalue_2x2", "1" },  { "max_eig_tridiag_3x3", "1" },
+        { "max_eig_path_4", "1" },      { "max_eig_path_8", "1" },
+        { "max_eig_path_16", "1" },     { "separable_12block", "1" },
+        { "two_block_corr_coupled", "3" },
+    };
+    int nn = (int) (sizeof nc / sizeof nc[0]);
+
+    printf("\nMIN NEGATION CROSS-CHECK (fjw): min<-C,X> bracket == -(max<C,X> bracket):\n");
+    for (int k = 0; k < nn; k++) {
+        const golden_case *c = find_case(cases, n, nc[k].name);
+        CHECK(c != NULL, "negation: golden discovered");
+        if (c == NULL)
+            continue;
+
+        arbsdp_problem p1, p2;
+        arbsdp_adaptive_result r1, r2;
+        slong prec_c = solve_to_iterate(&p1, &r1, c);           /* max <C,X> */
+
+        arbsdp_problem_init(&p2);
+        CHECK(arbsdp_read_sdpa(&p2, c->dats_path) == 0, "negation: read_sdpa");
+        negate_objective(&p2);                                   /* min <-C,X> */
+        CHECK(p2.maximize == 0, "negation: p2 is a minimize problem");
+
+        arbsdp_apriori ab;
+        arbsdp_apriori_init(&ab, p1.nblocks);
+        {
+            arb_t v; arb_init(v);
+            arb_set_str(v, nc[k].xbar, prec_c);
+            for (int b = 0; b < p1.nblocks; b++)
+                arbsdp_apriori_set_xbar(&ab, b, v);
+            arb_clear(v);
+        }
+
+        arb_t lb1, ub1, lb2, ub2, nlb1, nub1, opt, nopt, d, tol;
+        arb_init(lb1); arb_init(ub1); arb_init(lb2); arb_init(ub2);
+        arb_init(nlb1); arb_init(nub1); arb_init(opt); arb_init(nopt);
+        arb_init(d); arb_init(tol);
+
+        arbsdp_certify_status s1 =
+            arbsdp_certify_bracket(lb1, ub1, &p1, &r1.res.it, &ab, prec_c);
+        arb_neg(nlb1, lb1);
+        arb_neg(nub1, ub1);
+
+        /* (c1) same iterate -> bit-exact negation. */
+        arbsdp_certify_status s2 =
+            arbsdp_certify_bracket(lb2, ub2, &p2, &r1.res.it, &ab, prec_c);
+        CHECK(s1 == ARBSDP_CERTIFY_OPTIMAL_BRACKET && s2 == s1,
+              "negation(c1): both OPTIMAL_BRACKET");
+        CHECK(arb_equal(lb2, nub1), "negation(c1): lb_min == -ub_max (bit-exact)");
+        CHECK(arb_equal(ub2, nlb1), "negation(c1): ub_min == -lb_max (bit-exact)");
+
+        /* (c2) independent min solve. */
+        {
+            arbsdp_precision_params pp;
+            arbsdp_precision_default_params(&pp);
+            pp.target_digits = 15;
+            arbsdp_solve_adaptive(&r2, &p2, &pp);
+        }
+        slong prec_c2 = r2.final_prec + 128;
+        arbsdp_certify_status s3 =
+            arbsdp_certify_bracket(lb2, ub2, &p2, &r2.res.it, &ab, prec_c2);
+        CHECK(s3 == ARBSDP_CERTIFY_OPTIMAL_BRACKET, "negation(c2): OPTIMAL_BRACKET");
+        parse_opt_enclosure(opt, c, CMP_PREC);
+        arb_neg(nopt, opt);
+        {
+            arf_t o_lo, o_hi, l, u;
+            arf_init(o_lo); arf_init(o_hi); arf_init(l); arf_init(u);
+            arb_get_lbound_arf(o_lo, nopt, CMP_PREC);
+            arb_get_ubound_arf(o_hi, nopt, CMP_PREC);
+            arb_get_lbound_arf(l, lb2, CMP_PREC);
+            arb_get_ubound_arf(u, ub2, CMP_PREC);
+            CHECK(arf_cmp(l, o_hi) <= 0, "negation(c2): lb_min <= -opt (P0 if not)");
+            CHECK(arf_cmp(o_lo, u) <= 0, "negation(c2): -opt <= ub_min (P0 if not)");
+            arf_clear(o_lo); arf_clear(o_hi); arf_clear(l); arf_clear(u);
+        }
+        /* agreement within ball rounding: |x2 - (-x1)| <= 2^-(prec_c-64) * max(1,|x1|) */
+        arb_one(tol);
+        {
+            arb_t a; arb_init(a);
+            arb_abs(a, ub1);
+            if (arb_gt(a, tol)) arb_set(tol, a);
+            arb_clear(a);
+        }
+        arb_mul_2exp_si(tol, tol, -(prec_c - 64));
+        arb_sub(d, lb2, nub1, CMP_PREC); arb_abs(d, d);
+        CHECK(arb_le(d, tol), "negation(c2): lb_min ~= -ub_max");
+        int exact_lo = arb_equal(lb2, nub1);
+        arb_sub(d, ub2, nlb1, CMP_PREC); arb_abs(d, d);
+        CHECK(arb_le(d, tol), "negation(c2): ub_min ~= -lb_max");
+        int exact_hi = arb_equal(ub2, nlb1);
+
+        {
+            char *a = arb_get_str(lb2, 12, ARB_STR_NO_RADIUS);
+            char *b = arb_get_str(ub2, 12, ARB_STR_NO_RADIUS);
+            printf("  %-22s min-bracket=[%s, %s]  c2 bit-exact=%s\n",
+                   nc[k].name, a, b, (exact_lo && exact_hi) ? "yes" : "no");
+            flint_free(a); flint_free(b);
+        }
+
+        arb_clear(lb1); arb_clear(ub1); arb_clear(lb2); arb_clear(ub2);
+        arb_clear(nlb1); arb_clear(nub1); arb_clear(opt); arb_clear(nopt);
+        arb_clear(d); arb_clear(tol);
+        arbsdp_apriori_clear(&ab);
+        arbsdp_adaptive_result_clear(&r2);
+        arbsdp_adaptive_result_clear(&r1);
+        arbsdp_problem_clear(&p2);
+        arbsdp_problem_clear(&p1);
+    }
+}
