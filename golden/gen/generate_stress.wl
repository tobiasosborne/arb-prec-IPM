(* Golden-master STRESS generator for arbsdp.
   Bead: arb-prec-IPM-epic.3.
   Produces the 9 new size/conditioning stress problems pinned by
   golden/gen/STRESS_DESIGN.md (binding contract).

   SELF-CONTAINED: FormatNum / WriteDatS / WriteProvenance are copied from
   golden/gen/generate.wl (do NOT run generate.wl; it would clobber the
   hand-calibrated v2 provenance fields of the existing 7 goldens).

   This script emits ONLY v1 provenance fields (name, source, description, m,
   block_sizes, maximize, optimal_value, optimal_value_digits, reference_method,
   generated_by). The v2 runner fields (target_digits/prec_cap/known_gaps/...)
   are calibrated from MEASURED solver behavior in a later step; golden_provenance.c
   supplies safe defaults when they are absent.

   Convention: external form max/min <C,X> s.t. <A_i,X>=b_i, X = blkdiag(...) >= 0.
   SDPA sparse format:
     line 1: m (constraints)
     line 2: nblocks
     line 3: block sizes (positive=PSD, negative=diagonal/LP)
     line 4: b vector
     remaining: "i block k l v" (i=0->C, i>=1->A_i; k<=l, 1-indexed upper-triangle)

   SDPA inner-product accounting (the load-bearing gotcha, README.md / STRESS_DESIGN §2):
   an entry "i block k l v" with k<l stores A_kl=A_lk=v, so <A,X> += 2*v*X_kl.
   Therefore: to realize an objective coefficient 1 on x_12 store v=1/2; to realize
   a matrix C=T_n(a,b) store the ACTUAL entries (diag v=a, super-diag v=b).
*)

(* ------------------------------------------------------------------
   FormatNum: convert exact/symbolic number to plain decimal string
   with 65 significant digits, no scientific notation.
   Adapted from generate.wl. CRITICAL FIX vs the original: RealDigits
   DROPS the sign of a negative input (RealDigits[-1/2,10,65] -> magnitude
   digits only). The original FormatNum was never exercised on a negative
   value, so this was a latent sign-loss bug. two_block_corr_coupled's A_5
   coupling has a -1/2 entry (x1_12 - x2_12 = 0); without the sign the
   constraint would silently become x1_12 + x2_12 = 0 and the golden optimum
   would be wrong (a P0 data corruption, CLAUDE.md rule 2). We format the
   magnitude and prepend "-" for negatives.
   ------------------------------------------------------------------ *)
FormatNum[x_] := Module[{ax, sgn, dec, digits, exp, intPart, fracPart, zeros, body},
  sgn = If[x < 0, "-", ""];
  ax  = Abs[x];
  dec = RealDigits[ax, 10, 65];
  digits = dec[[1]];
  exp    = dec[[2]];
  body = Which[
    exp >= 1 && exp <= 65,
      intPart  = StringJoin[ToString /@ Take[digits, exp]];
      fracPart = StringJoin[ToString /@ Drop[digits, exp]];
      intPart <> "." <> fracPart,
    exp <= 0,
      zeros    = StringJoin[Table["0", {-exp}]];
      fracPart = zeros <> StringJoin[ToString /@ digits];
      "0." <> fracPart,
    True,
      ToString[N[ax, 65], InputForm]
  ];
  sgn <> body
];

(* ------------------------------------------------------------------
   WriteProvenance: write provenance.json (v1 fields only).
   Adapted from generate.wl to take a `maximize` parameter (problem
   min_eig_path_4 is a minimization; here all 9 are maximize=true, but
   the parameter is kept explicit and honest).
   ------------------------------------------------------------------ *)
WriteProvenance[dir_, name_, desc_, m_, blockSizes_, maximize_, optValStr_,
               optValDigits_, refMethod_] :=
  Module[{json, path},
    json = StringJoin[
      "{\n",
      "  \"name\": \"", name, "\",\n",
      "  \"source\": \"wolframscript\",\n",
      "  \"description\": \"", desc, "\",\n",
      "  \"m\": ", ToString[m], ",\n",
      "  \"block_sizes\": [", StringRiffle[ToString /@ blockSizes, ", "], "],\n",
      "  \"maximize\": ", If[maximize, "true", "false"], ",\n",
      "  \"optimal_value\": \"", optValStr, "\",\n",
      "  \"optimal_value_digits\": ", ToString[optValDigits], ",\n",
      "  \"reference_method\": \"", refMethod, "\",\n",
      "  \"generated_by\": \"arbsdp golden-master generator epic.3 / wolframscript\"\n",
      "}"
    ];
    path = FileNameJoin[{dir, "provenance.json"}];
    Export[path, json, "Text"];
    Print["  wrote: ", path];
  ];

(* ------------------------------------------------------------------
   WriteDatS: write SDPA sparse .dat-s file.
   (Copied from generate.wl; headerNote lets us label the objective sense.)
   entries: list of {i, block, k, l, v} with i=0->C, i>=1->A_i; block 1-indexed;
   k,l 1-indexed, k<=l (upper triangle); v exact Mathematica number.
   ------------------------------------------------------------------ *)
WriteDatS[dir_, name_, headerNote_, m_, blockSizes_, bVec_, entries_] :=
  Module[{path, lines},
    lines = {
      "* " <> name <> " - generated by arbsdp golden-master generator (epic.3)",
      "* " <> headerNote <> " <C,X> s.t. <A_i,X>=b_i, X blkdiag >= 0",
      ToString[m],
      ToString[Length[blockSizes]],
      StringRiffle[ToString /@ blockSizes, " "],
      StringRiffle[FormatNum /@ bVec, " "]
    };
    Do[
      AppendTo[lines,
        StringRiffle[{
          ToString[e[[1]]],
          ToString[e[[2]]],
          ToString[e[[3]]],
          ToString[e[[4]]],
          FormatNum[e[[5]]]
        }, " "]
      ],
      {e, entries}
    ];
    path = FileNameJoin[{dir, name <> ".dat-s"}];
    Export[path, StringRiffle[lines, "\n"], "Text"];
    Print["  wrote: ", path];
  ];

baseDir = FileNameJoin[{DirectoryName[$InputFileName], ".."}];

(* ==================================================================
   FAMILY A — scalable tridiagonal max-eigenvalue (max_eig_path_n)
   block_sizes=[n], m=1, maximize. C=T_n(2,1) (diag 2, off-diag 1), A_1=I_n,
   b=[1]. opt = lambda_max(C) = 2 + 2 cos(pi/(n+1)) (CLOSED FORM).
   .dat-s realizes <C,X> = 2*sum X_ii + 2*sum X_{i,i+1} and <A_1,X> = tr(X).
   ================================================================== *)
WriteMaxEigPath[n_] := Module[{name, dir, entries, optVal, optStr},
  name = "max_eig_path_" <> ToString[n];
  dir  = FileNameJoin[{baseDir, name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  (* C = T_n(2,1): diagonal v=2 (i=1..n), super-diagonal v=1 (i=1..n-1). *)
  entries = {};
  Do[AppendTo[entries, {0, 1, i, i, 2}], {i, 1, n}];                 (* C diag *)
  Do[AppendTo[entries, {0, 1, i, i + 1, 1}], {i, 1, n - 1}];          (* C super-diag *)
  Do[AppendTo[entries, {1, 1, i, i, 1}], {i, 1, n}];                 (* A_1 = I_n *)
  (* CLOSED FORM optimum (NOT a numeric eigensolve). *)
  optVal = 2 + 2 Cos[Pi/(n + 1)];
  optStr = FormatNum[optVal];
  Print["[max_eig_path_", n, "] opt = 2+2cos(pi/", n + 1, ") = ", optStr];
  WriteDatS[dir, name, "maximize", 1, {n}, {1}, entries];
  WriteProvenance[dir, name,
    ToString[n] <> "x" <> ToString[n] <>
    " SDP: max <C,X> s.t. tr(X)=1, X " <> ToString[n] <> "x" <> ToString[n] <>
    " PSD, C = tridiagonal Toeplitz T_" <> ToString[n] <>
    "(2,1) (diagonal 2, off-diagonal 1). By the variational formula opt = lambda_max(C) = 2 + 2 cos(pi/" <>
    ToString[n + 1] <>
    "). Optimal X* is the rank-1 projector onto the top eigenvector (singular, boundary optimum). Scalable size-stress family (n=4,8,16).",
    1, {n}, True, optStr, 65,
    "Closed form lambda_max(T_n(2,1)) = 2 + 2 cos(pi/(n+1)); n=" <> ToString[n] <>
    ". Cross-checked in mpmath 1.3.0 and sympy 1.14.0 against an explicit symmetric eigensolve to >60 digits."
  ];
  optStr
];

resMaxEig = Association[];
Do[resMaxEig[n] = WriteMaxEigPath[n], {n, {4, 8, 16}}];

(* ==================================================================
   PROBLEM 4 — disparate_scale_sqrt2
   block_sizes=[2], m=2, maximize. max x_12 s.t. x_11=P, x_22=Q, X 2x2 PSD.
   P=2e8, Q=1e-8, P*Q=2. opt = sqrt(P*Q) = sqrt(2) (CLOSED FORM).
   C off-diag (1,2) v=1/2  =>  <C,X> = 2*(1/2)*x_12 = x_12.
   A_1 (1,1) v=1; A_2 (2,2) v=1; b=[P, Q].
   ================================================================== *)
Module[{name, dir, P, Q, optVal, optStr},
  name = "disparate_scale_sqrt2";
  dir  = FileNameJoin[{baseDir, name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  P = 2*10^8;       (* exact *)
  Q = 1/10^8;       (* exact *)
  optVal = Sqrt[P*Q];   (* = Sqrt[2] *)
  optStr = FormatNum[optVal];
  Print["[disparate_scale_sqrt2] P*Q = ", P*Q, ", opt = sqrt(P*Q) = ", optStr];
  WriteDatS[dir, name, "maximize", 2, {2}, {P, Q}, {
    {0, 1, 1, 2, 1/2},   (* C_{12}=1/2 => <C,X> = x_12 *)
    {1, 1, 1, 1, 1},     (* A_1 = e1 e1^T => x_11 = P *)
    {2, 1, 2, 2, 1}      (* A_2 = e2 e2^T => x_22 = Q *)
  }];
  WriteProvenance[dir, name,
    "2x2 SDP: max x_12 s.t. x_11=2e8, x_22=1e-8, X 2x2 PSD. PSD => x_12^2 <= x_11*x_22 = 2, so opt = sqrt(P*Q) = sqrt(2) (irrational, rank-1 boundary X*). Stresses the central-path Schur complement: NT scaling W ~ diag(P,Q), M = diag(w1^2,w2^2), cond(M) ~ (P/Q)^2 ~ 4e32 >> 1e10. Also a disparate-magnitude RHS (P/Q = 2e16).",
    2, {2}, True, optStr, 65,
    "Closed form: Schur complement x_11*x_22 - x_12^2 >= 0 gives opt = sqrt(P*Q) = sqrt(2) with P=2e8, Q=1e-8. Cross-checked in mpmath 1.3.0 and sympy 1.14.0."
  ];
];

(* ==================================================================
   PROBLEMS 5,6,7 — diag_weight_kappaK
   block_sizes=[len(w)], m=1, maximize. max <diag(w),X> s.t. tr(X)=1, X PSD.
   C = diag(w); A_1 = I; b=[1]. opt = max_i w_i = 1 (CLOSED FORM, exact).
   ================================================================== *)
WriteDiagWeight[name_, weights_, desc_, refMethod_] := Module[{dir, n, entries, optVal, optStr},
  dir = FileNameJoin[{baseDir, name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  n = Length[weights];
  entries = {};
  Do[AppendTo[entries, {0, 1, i, i, weights[[i]]}], {i, 1, n}];   (* C = diag(w) *)
  Do[AppendTo[entries, {1, 1, i, i, 1}], {i, 1, n}];              (* A_1 = I_n *)
  optVal = Max[weights];     (* = 1, exact *)
  optStr = FormatNum[optVal];
  Print["[", name, "] weights = ", weights, ", opt = Max[weights] = ", optStr];
  WriteDatS[dir, name, "maximize", 1, {n}, {1}, entries];
  WriteProvenance[dir, name, desc, 1, {n}, True, optStr, 65, refMethod];
  optStr
];

resK6  = WriteDiagWeight["diag_weight_kappa6",  {1, 1/10^3, 1/10^6},
  "3x3 SDP: max <diag(1,1e-3,1e-6),X> s.t. tr(X)=1, X 3x3 PSD. opt = max weight = 1 (exact, rank-1 boundary X*=e1 e1^T). Data-matrix condition number cond(C) = max/min weight = 1e6. Conditioning-ladder sibling (1e6 rung).",
  "Closed form: opt = lambda_max(diag(w)) = max_i w_i = 1 (exact). Trivially verified in mpmath/sympy: max(weights)=1."];

resK10 = WriteDiagWeight["diag_weight_kappa10", {1, 1/10^5, 1/10^10},
  "3x3 SDP: max <diag(1,1e-5,1e-10),X> s.t. tr(X)=1, X 3x3 PSD. opt = max weight = 1 (exact, rank-1 boundary X*=e1 e1^T). Data-matrix condition number cond(C) = max/min weight = 1e10 (meets the kappa>=1e10 bar). Conditioning-ladder sibling (1e10 rung).",
  "Closed form: opt = lambda_max(diag(w)) = max_i w_i = 1 (exact). Trivially verified in mpmath/sympy: max(weights)=1."];

resK12 = WriteDiagWeight["diag_weight_kappa12", {1, 1/10^4, 1/10^8, 1/10^12},
  "4x4 SDP: max <diag(1,1e-4,1e-8,1e-12),X> s.t. tr(X)=1, X 4x4 PSD. opt = max weight = 1 (exact, rank-1 boundary X*=e1 e1^T). Data-matrix condition number cond(C) = max/min weight = 1e12 exactly (same conditioning class as the Hilbert moment matrix H_8, but with a provable exact optimum). Required kappa>=1e10 representative.",
  "Closed form: opt = lambda_max(diag(w)) = max_i w_i = 1 (exact). Trivially verified in mpmath/sympy: max(weights)=1."];

(* ==================================================================
   PROBLEM 8 — two_block_corr_coupled
   block_sizes=[2,2], m=5, maximize. Two 2x2 PSD blocks, coupled.
   max x1_12 + x2_12 s.t. x1_11=1,x1_22=2,x2_11=1,x2_22=2, x1_12 - x2_12 = 0.
   Each block: t^2 <= 1*2 => t <= sqrt(2). opt = 2*sqrt(2) (CLOSED FORM).
   ================================================================== *)
Module[{name, dir, optVal, optStr},
  name = "two_block_corr_coupled";
  dir  = FileNameJoin[{baseDir, name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  optVal = 2 Sqrt[2];
  optStr = FormatNum[optVal];
  Print["[two_block_corr_coupled] opt = 2*sqrt(2) = ", optStr];
  WriteDatS[dir, name, "maximize", 5, {2, 2}, {1, 2, 1, 2, 0}, {
    {0, 1, 1, 2, 1/2},    (* C block1 off-diag => +x1_12 *)
    {0, 2, 1, 2, 1/2},    (* C block2 off-diag => +x2_12 *)
    {1, 1, 1, 1, 1},      (* A_1: x1_11 = 1 *)
    {2, 1, 2, 2, 1},      (* A_2: x1_22 = 2 *)
    {3, 2, 1, 1, 1},      (* A_3: x2_11 = 1 *)
    {4, 2, 2, 2, 1},      (* A_4: x2_22 = 2 *)
    {5, 1, 1, 2, 1/2},    (* A_5: +x1_12 *)
    {5, 2, 1, 2, -1/2}    (* A_5: -x2_12 *)
  }];
  WriteProvenance[dir, name,
    "Two coupled 2x2 PSD blocks (genuine SDP, not SDP+LP): max x1_12 + x2_12 s.t. x1_11=1,x1_22=2,x2_11=1,x2_22=2 and the coupling x1_12 - x2_12 = 0. Each block PSD bound t^2 <= 1*2 gives t <= sqrt(2), identical for both, so BOTH blocks sit on their rank-1 boundary at the optimum. opt = 2*sqrt(2). The coupling makes the 5x5 Schur genuinely mix the two blocks (not block-diagonal).",
    5, {2, 2}, True, optStr, 65,
    "Closed form: each block t^2 <= x_11*x_22 = 2 => t <= sqrt(2); coupling forces equal off-diagonals, objective 2t maximized at 2*sqrt(2). Cross-checked in mpmath 1.3.0 and sympy 1.14.0."
  ];
];

(* ==================================================================
   PROBLEM 9 — separable_12block
   block_sizes=[2]x12, m=12, maximize. For c=1..12: block c cost A_c=[[c,1],[1,0]],
   own trace constraint. opt = sum_c lambda_max(A_c) = sum_c (c/2 + sqrt(c^2/4+1)).
   <A_c,X_c> = c*x_11 + 2*x_12: C block c diag (1,1) v=c, off-diag (1,2) v=1.
   A_c trace: block c (1,1) v=1, (2,2) v=1, b_c=1.
   ================================================================== *)
Module[{name, dir, nb, entries, bVec, optVal, optStr},
  name = "separable_12block";
  dir  = FileNameJoin[{baseDir, name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  nb = 12;
  entries = {};
  Do[
    AppendTo[entries, {0, c, 1, 1, c}];   (* C block c: c * x_11 *)
    AppendTo[entries, {0, c, 1, 2, 1}];   (* C block c off-diag => 2*x_12 *)
    AppendTo[entries, {c, c, 1, 1, 1}];   (* A_c trace: X_c,11 *)
    AppendTo[entries, {c, c, 2, 2, 1}],   (* A_c trace: X_c,22 *)
    {c, 1, nb}
  ];
  bVec = ConstantArray[1, nb];
  optVal = Sum[c/2 + Sqrt[c^2/4 + 1], {c, 1, nb}];   (* CLOSED FORM sum of 12 surds *)
  optStr = FormatNum[optVal];
  Print["[separable_12block] opt = sum_{c=1}^{12}(c/2+sqrt(c^2/4+1)) = ", optStr];
  WriteDatS[dir, name, "maximize", nb, ConstantArray[2, nb], bVec, entries];
  WriteProvenance[dir, name,
    "Twelve 2x2 PSD blocks (m=12), separable. For c=1..12 block c has cost A_c=[[c,1],[1,0]] and its own trace constraint tr(X_c)=1. Separable => opt = sum_c lambda_max(A_c) = sum_{c=1}^{12} (c/2 + sqrt(c^2/4 + 1)). Each X_c* is the rank-1 projector onto its top eigenvector (boundary). Large-m Schur ASSEMBLY/storage stressor with 12 PSD blocks (the Schur is block-diagonal: one 1x1 block per constraint).",
    nb, ConstantArray[2, nb], True, optStr, 65,
    "Closed form: lambda_max([[c,1],[1,0]]) = c/2 + sqrt(c^2/4 + 1); opt = sum over c=1..12. Cross-checked in mpmath 1.3.0 (closed-form sum vs per-block numeric eigensolve, diff 0 at 40 digits)."
  ];
];

