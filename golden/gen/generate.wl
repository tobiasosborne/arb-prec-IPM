(* Golden-master SDP generator for arbsdp.
   Bead: arb-prec-IPM-b09.
   Produces SDPA sparse .dat-s files plus provenance.json for each problem.

   Convention: maximize <C,X> s.t. <A_i,X>=b_i, X = blkdiag(...) >= 0.
   SDPA sparse format per SdpaSparse.ts:
     line 1: m (constraints)
     line 2: nblocks
     line 3: block sizes (positive=PSD, negative=diagonal/LP)
     line 4: b vector
     remaining: "i block k l v" (i=0->C, i>=1->A_i; k<=l, 1-indexed upper-triangle)
*)

(* ------------------------------------------------------------------
   FormatNum: convert exact/symbolic number to plain decimal string
   with 65 significant digits, no scientific notation.
   ------------------------------------------------------------------ *)
FormatNum[x_] := Module[{dec, digits, exp, intPart, fracPart, zeros},
  dec = RealDigits[x, 10, 65];
  digits = dec[[1]];
  exp    = dec[[2]];
  Which[
    exp >= 1 && exp <= 65,
      intPart  = StringJoin[ToString /@ Take[digits, exp]];
      fracPart = StringJoin[ToString /@ Drop[digits, exp]];
      intPart <> "." <> fracPart,
    exp <= 0,
      zeros    = StringJoin[Table["0", {-exp}]];
      fracPart = zeros <> StringJoin[ToString /@ digits];
      "0." <> fracPart,
    True,
      (* Should not occur for our problem values; fallback *)
      ToString[N[x, 65], InputForm]
  ]
];

(* ------------------------------------------------------------------
   WriteProvenance: write provenance.json
   ------------------------------------------------------------------ *)
WriteProvenance[dir_, name_, desc_, m_, blockSizes_, optValStr_,
               optValDigits_, refMethod_] :=
  Module[{json, path},
    json = StringJoin[
      "{\n",
      "  \"name\": \"", name, "\",\n",
      "  \"source\": \"wolframscript\",\n",
      "  \"description\": \"", desc, "\",\n",
      "  \"m\": ", ToString[m], ",\n",
      "  \"block_sizes\": [", StringRiffle[ToString /@ blockSizes, ", "], "],\n",
      "  \"maximize\": true,\n",
      "  \"optimal_value\": \"", optValStr, "\",\n",
      "  \"optimal_value_digits\": ", ToString[optValDigits], ",\n",
      "  \"reference_method\": \"", refMethod, "\",\n",
      "  \"generated_by\": \"arbsdp golden-master generator b09 / wolframscript 1.13.0\"\n",
      "}"
    ];
    path = FileNameJoin[{dir, "provenance.json"}];
    Export[path, json, "Text"];
    Print["  wrote: ", path];
  ];

(* ------------------------------------------------------------------
   WriteDatS: write SDPA sparse .dat-s file.
   entries: list of {i, block, k, l, v} with:
     i=0 -> C, i>=1 -> A_i
     block: 1-indexed
     k,l: 1-indexed, k <= l (upper triangle)
     v: exact Mathematica number (will be formatted via FormatNum)
   ------------------------------------------------------------------ *)
WriteDatS[dir_, name_, m_, blockSizes_, bVec_, entries_] :=
  Module[{path, lines},
    lines = {
      "* " <> name <> " - generated by arbsdp golden-master generator (b09)",
      "* maximize <C,X> s.t. <A_i,X>=b_i, X blkdiag >= 0",
      ToString[m],
      ToString[Length[blockSizes]],
      StringRiffle[ToString /@ blockSizes, " "],
      StringRiffle[FormatNum /@ bVec, " "]
    };
    Do[
      AppendTo[lines,
        StringRiffle[{
          ToString[e[[1]]],
          ToString[e[[2]]],
          ToString[e[[3]]],
          ToString[e[[4]]],
          FormatNum[e[[5]]]
        }, " "]
      ],
      {e, entries}
    ];
    path = FileNameJoin[{dir, name <> ".dat-s"}];
    Export[path, StringRiffle[lines, "\n"], "Text"];
    Print["  wrote: ", path];
  ];

(* ------------------------------------------------------------------
   PROBLEM 1: trivial_2x2
   max x_11  s.t.  x_11=1, X=[[x_11,x_12],[x_12,x_22]] >= 0.
   Optimal: X*=diag(1,0), opt=1. RANK-DEFICIENT / BOUNDARY optimum.
   C = e1 e1^T, A_1 = e1 e1^T, b_1 = 1.
   ------------------------------------------------------------------ *)
Print["[1/7] trivial_2x2"];
Module[{name, dir},
  name = "trivial_2x2";
  dir  = FileNameJoin[{DirectoryName[$InputFileName], "..", name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  WriteDatS[dir, name, 1, {2}, {1}, {
    {0, 1, 1, 1, 1},   (* C_{11} = 1 *)
    {1, 1, 1, 1, 1}    (* A_1_{11} = 1 *)
  }];
  WriteProvenance[dir, name,
    "Trivial 2x2 SDP: max x_11 s.t. x_11=1, X>=0. Optimal X*=diag(1,0) is SINGULAR (rank-deficient boundary optimum). Tests that the solver handles PSD-boundary cases (CLAUDE.md invariant 1).",
    1, {2}, FormatNum[1], 65,
    "Exact closed form: X*=diag(1,0), opt=1 (integer)."
  ];
  Print["  opt = 1 (boundary, rank-deficient)"];
];

(* ------------------------------------------------------------------
   PROBLEM 2: max_eigenvalue_2x2
   max <A,X> s.t. tr(X)=1, X 2x2 PSD, where A=[[2,1],[1,2]].
   = lambda_max(A) = 3 (variational characterization).
   Optimal: X* = (1/2)*[[1,1],[1,1]] -- rank 1, BOUNDARY optimum.
   C = A = [[2,1],[1,2]],  A_1 = I_2,  b_1 = 1.
   ------------------------------------------------------------------ *)
Print["[2/7] max_eigenvalue_2x2"];
Module[{name, dir, A, optVal},
  name = "max_eigenvalue_2x2";
  dir  = FileNameJoin[{DirectoryName[$InputFileName], "..", name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  A = {{2, 1}, {1, 2}};
  optVal = Max[Eigenvalues[A]];  (* = 3, exact *)
  Print["  lambda_max(A) = ", optVal, " (eigenvalues: ", Eigenvalues[A], ")"];
  WriteDatS[dir, name, 1, {2}, {1}, {
    {0, 1, 1, 1, 2},   (* C_{11} = 2 *)
    {0, 1, 1, 2, 1},   (* C_{12} = 1 (upper-triangle) *)
    {0, 1, 2, 2, 2},   (* C_{22} = 2 *)
    {1, 1, 1, 1, 1},   (* A_1_{11} = 1 *)
    {1, 1, 2, 2, 1}    (* A_1_{22} = 1 *)
  }];
  WriteProvenance[dir, name,
    "2x2 SDP: max <A,X> s.t. tr(X)=1, X>=0 where A=[[2,1],[1,2]]. By the variational formula lambda_max(A) = max{<A,X>: tr(X)=1, X>=0}. Optimal X*=[[1/2,1/2],[1/2,1/2]] is RANK-1 SINGULAR (boundary optimum). Tests boundary/degenerate case.",
    1, {2}, FormatNum[optVal], 65,
    "Exact closed form: lambda_max([[2,1],[1,2]]) = 2+1 = 3 (eigenvalues 2 +/- 1, integer)."
  ];
  Print["  opt = ", optVal, " (boundary, rank-1)"];
];

(* ------------------------------------------------------------------
   PROBLEM 3: sdp_sqrt2
   max x_12  s.t.  x_11=1, x_22=2, X=[[x_11,x_12],[x_12,x_22]] >= 0.
   PSD requires x_12^2 <= x_11*x_22 = 2, so max x_12 = sqrt(2).
   Optimal: X* = [[1,sqrt(2)],[sqrt(2),2]] -- rank 1, det=0, BOUNDARY optimum.
   C: <C,X>=x_12 means C_{12}=C_{21}=1/2 (SDPA upper-tri entry v=1/2).
   A_1 = e1 e1^T, b_1=1; A_2 = e2 e2^T, b_2=2.
   ------------------------------------------------------------------ *)
Print["[3/7] sdp_sqrt2"];
Module[{name, dir, optVal},
  name = "sdp_sqrt2";
  dir  = FileNameJoin[{DirectoryName[$InputFileName], "..", name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  optVal = Sqrt[2];
  WriteDatS[dir, name, 2, {2}, {1, 2}, {
    {0, 1, 1, 2, 1/2},   (* C_{12}=1/2 => <C,X> = 2*(1/2)*x_12 = x_12 *)
    {1, 1, 1, 1, 1},     (* A_1_{11} = 1 *)
    {2, 1, 2, 2, 1}      (* A_2_{22} = 1 *)
  }];
  WriteProvenance[dir, name,
    "2x2 SDP: max x_12 s.t. x_11=1, x_22=2, X 2x2 PSD. PSD requires x_12^2 <= x_11*x_22=2, so max x_12=sqrt(2) (irrational). X*=[[1,sqrt(2)],[sqrt(2),2]] is RANK-1 SINGULAR (det=0, boundary optimum). Tests high-precision irrational values.",
    2, {2}, FormatNum[optVal], 65,
    "Exact closed form: Cauchy-Schwarz / Schur complement: max x_12 s.t. [[1,x_12],[x_12,2]]>=0 gives x_12<=sqrt(2). Computed Sqrt[2] via N[Sqrt[2],65] in Mathematica."
  ];
  Print["  opt = sqrt(2) = ", N[optVal, 20], " (irrational, boundary)"];
];

(* ------------------------------------------------------------------
   PROBLEM 4: lp_diagonal_block
   LP as 1 block of size -5 (5 nonneg variables: x1, x2, s1, s2, s3).
   max  x1 + 2*x2
   s.t. x1+x2+s1=4,  x1+s2=3,  x2+s3=3,  all variables >= 0.
   Optimal: (x1,x2)=(1,3), obj=1+6=7. Exact integer.
   ------------------------------------------------------------------ *)
Print["[4/7] lp_diagonal_block"];
Module[{name, dir},
  name = "lp_diagonal_block";
  dir  = FileNameJoin[{DirectoryName[$InputFileName], "..", name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  WriteDatS[dir, name, 3, {-5}, {4, 3, 3}, {
    {0, 1, 1, 1, 1},   (* C_{11}=1: x1 coefficient *)
    {0, 1, 2, 2, 2},   (* C_{22}=2: x2 coefficient *)
    {1, 1, 1, 1, 1},   (* A_1_{11}=1: x1 in x1+x2+s1=4 *)
    {1, 1, 2, 2, 1},   (* A_1_{22}=1: x2 *)
    {1, 1, 3, 3, 1},   (* A_1_{33}=1: s1 *)
    {2, 1, 1, 1, 1},   (* A_2_{11}=1: x1 in x1+s2=3 *)
    {2, 1, 4, 4, 1},   (* A_2_{44}=1: s2 *)
    {3, 1, 2, 2, 1},   (* A_3_{22}=1: x2 in x2+s3=3 *)
    {3, 1, 5, 5, 1}    (* A_3_{55}=1: s3 *)
  }];
  WriteProvenance[dir, name,
    "LP encoded as diagonal SDP block (block_sizes=[-5], 5 nonneg variables). max x1+2*x2 s.t. x1+x2<=4, x1<=3, x2<=3, x1,x2>=0 (slacks s1,s2,s3). Optimal vertex (x1,x2)=(1,3), obj=7. Tests LP-as-diagonal-block handling.",
    3, {-5}, FormatNum[7], 65,
    "Exact closed form: LP vertex enumeration, unique optimal vertex (1,3) with obj=1+2*3=7 (integer)."
  ];
  Print["  opt = 7 (LP as diagonal block, integer)"];
];

(* ------------------------------------------------------------------
   PROBLEM 5: ill_conditioned_3x3
   max  x_11 + epsilon * x_22   (epsilon = 10^-6)
   s.t. x_11=1, x_22=1, 2*x_12=0, X 3x3 PSD.
   Unique primal: x_11=x_22=1, x_12=0, x_13/x_23/x_33 free (PSD).
   Optimal value = 1 + 10^-6 = 1000001/1000000 (exact rational).
   The small epsilon makes the Schur complement mildly ill-conditioned.
   ------------------------------------------------------------------ *)
Print["[5/7] ill_conditioned_3x3"];
Module[{name, dir, epsilon, optVal},
  name = "ill_conditioned_3x3";
  dir  = FileNameJoin[{DirectoryName[$InputFileName], "..", name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  epsilon = 1/1000000;   (* exact rational *)
  optVal  = 1 + epsilon; (* = 1000001/1000000 *)
  WriteDatS[dir, name, 3, {3}, {1, 1, 0}, {
    {0, 1, 1, 1, 1},       (* C_{11} = 1 *)
    {0, 1, 2, 2, epsilon},  (* C_{22} = 10^-6 *)
    {1, 1, 1, 1, 1},       (* A_1_{11} = 1 *)
    {2, 1, 2, 2, 1},       (* A_2_{22} = 1 *)
    {3, 1, 1, 2, 1}        (* A_3_{12} = 1, upper-tri, so <A_3,X>=2*x_12=0 *)
  }];
  WriteProvenance[dir, name,
    "Mildly ill-conditioned 3x3 SDP: max x_11+epsilon*x_22 s.t. x_11=1, x_22=1, 2*x_12=0, X 3x3 PSD, where epsilon=1e-6. The small coefficient epsilon=1/1000000 creates mild ill-conditioning in the Schur complement. Optimal value = 1+1/1000000 = 1000001/1000000 (exact rational).",
    3, {3}, FormatNum[optVal], 65,
    "Exact closed form: opt = 1 + 10^(-6) = 1000001/1000000 (exact rational arithmetic in Mathematica)."
  ];
  Print["  opt = 1000001/1000000 = ", N[optVal, 20], " (mildly ill-conditioned)"];
];

(* ------------------------------------------------------------------
   PROBLEM 6: mixed_blocks
   Block 1: 2x2 PSD matrix X_1 = [[a,b],[b,1-a]] (tr=1 forced).
   Block 2: 1-dim nonneg scalar x_2.
   max  a + x_2
   s.t. tr(X_1) = 1       (b_1=1, A_1 = I_2 on block 1)
        x_2 + x_12 = 1/2  (b_2=1/2, A_2 uses block1 off-diag + block2)
        X_1 >= 0, x_2 >= 0.
   Optimal: a=(2+sqrt(2))/4, b=-sqrt(2)/4, x_2=1/2+sqrt(2)/4.
   Optimal value = 1 + sqrt(2)/2 = (2+sqrt(2))/2 (irrational).
   Tests: mixed PSD+LP blocks, irrational optimum.
   ------------------------------------------------------------------ *)
Print["[6/7] mixed_blocks"];
Module[{name, dir, optVal, sol},
  name = "mixed_blocks";
  dir  = FileNameJoin[{DirectoryName[$InputFileName], "..", name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  optVal = 1 + Sqrt[2]/2;
  (* Verify symbolically *)
  sol = Maximize[{a + x2,
    a >= 0, 1 - a >= 0, a*(1-a) - b^2 >= 0,
    x2 >= 0, x2 + b == 1/2},
    {a, b, x2}];
  Print["  Symbolic check: ", sol[[1]], " = ", FullSimplify[sol[[1]] - optVal], " (should be 0)"];
  WriteDatS[dir, name, 2, {2, -1}, {1, 1/2}, {
    {0, 1, 1, 1, 1},     (* C_block1_{11}=1: a coefficient *)
    {0, 2, 1, 1, 1},     (* C_block2_{11}=1: x_2 coefficient *)
    {1, 1, 1, 1, 1},     (* A_1_block1_{11}=1 (tr) *)
    {1, 1, 2, 2, 1},     (* A_1_block1_{22}=1 (tr) *)
    {2, 1, 1, 2, 1/2},   (* A_2_block1_{12}=1/2 => 2*(1/2)*x_12=x_12 in <A_2,X> *)
    {2, 2, 1, 1, 1}      (* A_2_block2_{11}=1: x_2 *)
  }];
  WriteProvenance[dir, name,
    "Mixed PSD+LP block SDP: block 1 is 2x2 PSD (tr=1), block 2 is 1-dim nonneg scalar. max (X_1)_{11}+x_2 s.t. tr(X_1)=1, x_2+x_12=1/2. Optimal value=1+sqrt(2)/2=(2+sqrt(2))/2 (irrational). Tests mixed block_sizes=[2,-1] and irrational optimum.",
    2, {2, -1}, FormatNum[optVal], 65,
    "Exact closed form: calculus optimization yields critical point a0=(2+sqrt(2))/4, opt=1+sqrt(2)/2. Verified by Mathematica Maximize."
  ];
  Print["  opt = 1+sqrt(2)/2 = ", N[optVal, 20], " (mixed blocks, irrational)"];
];

(* ------------------------------------------------------------------
   PROBLEM 7: trace_bound_3x3
   A clean 3x3 problem with a non-integer irrational optimum.

   max  2*x_12 + 2*x_13 + 2*x_23   (sum of all off-diagonal pairs)
   s.t. x_11 = 1, x_22 = 1, x_33 = 1    (correlation matrix: diagonal=1)
        X 3x3 PSD.

   By symmetry, set a=x_12, b=x_13, c=x_23.
   X = [[1,a,b],[a,1,c],[b,c,1]] PSD iff:
     1-a^2 >= 0, 1-b^2 >= 0, 1-c^2 >= 0 (necessary)
     det(X) = 1 - a^2 - b^2 - c^2 + 2abc >= 0.
   Maximize 2a+2b+2c over this region.

   By symmetry, the optimum is at a=b=c (all equal).
   With a=b=c=t: 1-3t^2+2t^3 >= 0 and t in [-1,1].
   Objective = 6t. Maximize t. Boundary: 1-3t^2+2t^3=0.
   Factor: (1-t)(1+t)^2 = 0... let me check: 1-3t^2+2t^3 = (1-t)^2(1+2t). Yes!
   So boundary at t=1 (double root) or t=-1/2.
   At t=1: X=[[1,1,1],[1,1,1],[1,1,1]], rank 1, obj=6.
   But t=1 satisfies all constraints: a=b=c=1, det=1-3+2=0 >= 0.

   Hmm, opt = 6 (integer). Let me verify: X=all-ones is PSD (eigenvalues 0,0,3).
   Maximizes 2(1+1+1) = 6.

   Let me choose a more interesting problem. How about maximizing just x_12+x_13
   (not x_23)?

   max  x_12 + x_13  s.t.  x_11=x_22=x_33=1, X 3x3 PSD.
   By symmetry in (a,b) with c=x_23 free: max a+b s.t. X>=0.
   The Mathematica solve earlier gave opt=2 (at a=b=c=1, X=all-ones).

   For a genuinely non-integer optimum I need asymmetric constraints.

   FINAL CHOICE: Largest eigenvalue of [[1,1/2,0],[1/2,1,1/2],[0,1/2,1]] -- tridiagonal.
   Eigenvalues: 1 +/- 1/sqrt(2) and 1. Max eigenvalue = 1 + 1/sqrt(2) = 1 + sqrt(2)/2.

   As SDP: max <A,X> s.t. tr(X)=1, X 3x3 PSD.
   A = [[1, 1/2, 0],[1/2, 1, 1/2],[0, 1/2, 1]] (symmetric tridiagonal).
   Optimal value = lambda_max(A) = 1 + 1/sqrt(2) = 1 + sqrt(2)/2.
   (same as mixed_blocks but here it's a 3x3 single PSD block, no LP).

   C = A, A_1 = I_3, b_1=1.
   SDPA entries for upper-triangle of C=A:
     C_{11}=1: (0,1,1,1,1)
     C_{12}=1/2: (0,1,1,2,1/2) -> contributes 2*(1/2)*x_12 = x_12
     C_{22}=1: (0,1,2,2,1)
     C_{23}=1/2: (0,1,2,3,1/2)
     C_{33}=1: (0,1,3,3,1)
   <C,X> = x_11 + 2*(1/2)*x_12 + x_22 + 2*(1/2)*x_23 + x_33
         = (x_11+x_22+x_33) + x_12 + x_23
         = tr(X) + x_12 + x_23.
   Since tr(X)=1 is fixed by A_1, we're maximizing 1 + x_12 + x_23.
   NOT the same as lambda_max(A).

   Hmm. Let me reconsider.
   <A,X> = tr(A^T X) = sum_{ij} A_{ij} X_{ij}.
   A = [[1,1/2,0],[1/2,1,1/2],[0,1/2,1]].
   <A,X> = A_{11}X_{11} + A_{12}X_{12} + A_{21}X_{21} + A_{22}X_{22} + A_{23}X_{23} + A_{32}X_{32} + A_{33}X_{33}
         (A_{13}=A_{31}=0).
         = X_{11} + X_{12} + X_{22} + X_{23} + X_{33}   (using A_{12}=A_{21}=1/2 and symmetric X: A_{12}X_{12}+A_{21}X_{21}=2*(1/2)*X_{12}=X_{12}).
         = tr(X) + X_{12} + X_{23}.

   In SDPA format: C stored as upper-triangle entries.
   C_{11}=1: entry (0,1,1,1,1) contributes 1*X_{11} = X_{11}.
   C_{12}=1/2: entry (0,1,1,2,1/2) contributes 2*(1/2)*X_{12} = X_{12}. (upper-triangle entry doubles in inner product)
   C_{22}=1: entry (0,1,2,2,1) contributes X_{22}.
   C_{23}=1/2: entry (0,1,2,3,1/2) contributes X_{23}.
   C_{33}=1: entry (0,1,3,3,1) contributes X_{33}.
   Total: X_{11}+X_{12}+X_{22}+X_{23}+X_{33}. Correct.

   Lambda_max of A: characteristic poly det(A-lambda*I)=0.
   A-lambda*I = [[1-lambda,1/2,0],[1/2,1-lambda,1/2],[0,1/2,1-lambda]].
   det = (1-lambda)[(1-lambda)^2 - 1/4] - (1/2)[(1/2)(1-lambda) - 0]
       = (1-lambda)^3 - (1-lambda)/4 - (1-lambda)/4
       = (1-lambda)^3 - (1-lambda)/2
       = (1-lambda)[(1-lambda)^2 - 1/2].
   Eigenvalues: lambda=1 and (1-lambda)^2=1/2 => 1-lambda = +/-1/sqrt(2) => lambda = 1 +/- 1/sqrt(2).
   lambda_max = 1 + 1/sqrt(2) = 1 + sqrt(2)/2. Confirmed.

   And lambda_max(A) = max{<A,X>: tr(X)=1, X>=0} by the variational formula.
   So optimal value = 1 + sqrt(2)/2 (different from the mixed_blocks problem; same number but different problem).

   Actually 1 + sqrt(2)/2 = 1 + 1/sqrt(2). Let me compute precisely:
   1 + sqrt(2)/2 = (2 + sqrt(2))/2 = 1.7071...
   Same as mixed_blocks. Let me pick a different matrix for variety.

   Use A = [[3, 1, 0],[1, 2, 1],[0, 1, 1]].
   Eigenvalues: solve det(A-lambda*I)=0.
*)
Print["[7/7] max_eig_tridiag_3x3"];
Module[{name, dir, A, eigenvals, optVal, sol},
  name = "max_eig_tridiag_3x3";
  dir  = FileNameJoin[{DirectoryName[$InputFileName], "..", name}];
  CreateDirectory[dir, CreateIntermediateDirectories -> True];
  A = {{3, 1, 0}, {1, 2, 1}, {0, 1, 1}};
  eigenvals = Eigenvalues[A];
  Print["  Eigenvalues of A = ", N[Sort[eigenvals], 30]];
  optVal = Max[eigenvals];
  Print["  lambda_max = ", optVal, " = ", N[optVal, 65]];
  (* Verify: max <A,X> s.t. tr(X)=1, X>=0 *)
  (* <A,X> = 3*x11 + 2*x12 + 2*x22 + 2*x23 + x33
     In SDPA upper-triangle entries:
     C_{11}=3: contributes 3*X_{11}
     C_{12}=1: entry v=1/2 (since <C,X> uses 2*v*X_{12} for off-diag) => v=1/2 for C_{12}=1
       Wait: actual A_{12}=1. In inner product <A,X> = 3*X_{11} + 1*X_{12} + 1*X_{21} + 2*X_{22} + 1*X_{23}+1*X_{32}+1*X_{33}
           = 3*X_{11} + 2*1*X_{12} + 2*X_{22} + 2*1*X_{23} + 1*X_{33}.
       SDPA entry (k=1,l=2,v) gives contribution 2*v*X_{12}. We want 2*X_{12}: v=1. OK so v=1 for C_{12}=1.
       Wait -- I need to be careful. In SdpaSparse.ts, the entry {i, block, k, l, v} with k<l
       represents A_{kl} = A_{lk} = v. The inner product <A,X> = sum_{k,l} A_{kl}*X_{kl}
       = sum_{k=l} A_{kk}*X_{kk} + sum_{k<l} (A_{kl}*X_{kl} + A_{lk}*X_{lk}) = sum_{k=l} v*X_{kk} + sum_{k<l} 2*v*X_{kl}.
       So for A_{12}=1: we store v=1, contribution = 2*1*X_{12} = 2*X_{12}. Correct.
       So for C = A: store diagonal entries with v = A_{kk}, off-diagonal with v = A_{kl} (not v=A_{kl}/2).
  *)
  (* Verify: A_{12}=A_{21}=1, so upper-tri entry (k=1,l=2,v=1) gives <A,X>_{12} contribution = 2*X_{12}. *)
  (* But the actual A_{12}*X_{12} + A_{21}*X_{21} = 1*X_{12} + 1*X_{12} = 2*X_{12}. Correct! *)
  WriteDatS[dir, name, 1, {3}, {1}, {
    {0, 1, 1, 1, 3},   (* C_{11}=3 *)
    {0, 1, 1, 2, 1},   (* C_{12}=1 (off-diag, v=1) *)
    {0, 1, 2, 2, 2},   (* C_{22}=2 *)
    {0, 1, 2, 3, 1},   (* C_{23}=1 *)
    {0, 1, 3, 3, 1},   (* C_{33}=1 *)
    {1, 1, 1, 1, 1},   (* A_1_{11}=1 (trace) *)
    {1, 1, 2, 2, 1},   (* A_1_{22}=1 *)
    {1, 1, 3, 3, 1}    (* A_1_{33}=1 *)
  }];
  WriteProvenance[dir, name,
    "3x3 SDP: max <A,X> s.t. tr(X)=1, X 3x3 PSD, where A=[[3,1,0],[1,2,1],[0,1,1]]. By variational formula opt=lambda_max(A). Eigenvalues are roots of (3-t)(2-t)(1-t)-2(3-t)-1, giving an irrational lambda_max. Optimal X* is the rank-1 projector onto the max eigenvector (singular, boundary optimum).",
    1, {3}, FormatNum[optVal], 65,
    "Exact closed form: lambda_max of [[3,1,0],[1,2,1],[0,1,1]] computed symbolically in Mathematica. Characteristic polynomial roots obtained via Root[] and evaluated to 65 digits."
  ];
  Print["  opt = ", N[optVal, 20], " (3x3, irrational, boundary)"];
];

